# Токен не коммитить. В Render добавить как Environment Variable.
BOT_TOKEN=123456789:REPLACE_WITH_REAL_TOKEN

# Для Render после создания сервиса:
# WEBHOOK_BASE_URL=https://your-service-name.onrender.com
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=replace-with-long-random-string
WEBHOOK_DROP_PENDING_UPDATES=true
PORT=8080
